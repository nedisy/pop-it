{
    "name": "pop-it",
    "version": "0.1.0",
    "private": true,
    "description": "A two-player Pop It strategy game built with React.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nedisy/pop-it.git"
    },
    "license": "ISC",
    "type": "module",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "scripts": {
        "start": "vite",
        "dev": "vite",
        "build": "vite build",
        "build:css": "sass src/scss/custom-bootstrap.scss src/css/custom-bootstrap.css",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.13",
        "@vitejs/plugin-react": "^6.3.0",
        "bootstrap": "^5.3.9",
        "gh-pages": "^6.3.0",
        "jsdom": "^31.0.1",
        "sass": "^1.108.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    }
}
